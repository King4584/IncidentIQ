# ==========================================
# IncidentIQ AI - Environment Configuration Example
# ==========================================

# Application Settings
PROJECT_NAME="IncidentIQ AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL="sqlite+aiosqlite:///./incidentiq.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/incidentiq_db"

# JWT Security
SECRET_KEY="your-super-secret-jwt-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Azure OpenAI Credentials (Required for AI Investigation Agent)
AZURE_OPENAI_ENDPOINT="https://your-azure-openai-endpoint.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key-here"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-ada-002"

# Standard OpenAI Credentials (Optional Alternative)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
